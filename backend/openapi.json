{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "properties": {
          "login": {
            "title": "Login",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Mutation": {
        "properties": {
          "body": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Body",
            "type": "object"
          },
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
          },
          "expectedRevision": {
            "minimum": 0.0,
            "title": "Expectedrevision",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "operationID": {
            "format": "uuid",
            "title": "Operationid",
            "type": "string"
          }
        },
        "required": [
          "operationID",
          "id",
          "kind",
          "expectedRevision",
          "body"
        ],
        "title": "Mutation",
        "type": "object"
      },
      "Push": {
        "properties": {
          "mutations": {
            "items": {
              "$ref": "#/components/schemas/Mutation"
            },
            "maxItems": 100,
            "title": "Mutations",
            "type": "array"
          }
        },
        "required": [
          "mutations"
        ],
        "title": "Push",
        "type": "object"
      },
      "Refresh": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "Refresh",
        "type": "object"
      },
      "UploadRequest": {
        "properties": {
          "checksum": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checksum",
            "type": "string"
          },
          "fileID": {
            "format": "uuid",
            "title": "Fileid",
            "type": "string"
          },
          "size": {
            "maximum": 10737418240.0,
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "fileID",
          "size",
          "checksum"
        ],
        "title": "UploadRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
